# 复制此文件为 .env 并填入实际值
# cp env.example .env

# Flask 密钥（必须修改！生成方式：python3 -c "import secrets; print(secrets.token_hex(32))"）
SECRET_KEY=change-this-to-a-random-string

# 数据库（SQLite 适合小规模，大规模建议用 PostgreSQL）
DATABASE_URL=sqlite:///pc28.db
# DATABASE_URL=postgresql://user:pass@localhost/pc28

# 外部 API 配置
API_TOKEN=your-api-token-here
API_BASE_URL=http://hanxin28.com/api/api.php
GAME_TYPE=jnd28

# 轮询间隔（秒）
POLL_INTERVAL=15

# 历史记录获取数量
HISTORY_FETCH_LIMIT=50

# API 超时（秒）
API_TIMEOUT=10
